# ── Backend integration ─────────────────────────────────────────────────────
# Every domain talks to the real API, always — there is no switch, so every page needs the
# backend running. See docs/LOCAL_DEV.md.

# Keep the relative "/api" in dev and in deploys: the proxy keeps requests same-origin, which is
# what `connect-src 'self'` and the SameSite=Lax refresh cookie both require. Deploys set API_ORIGIN.
VITE_API_BASE=/api

# local | sandbox | prod. Only a production build reads it: anything but "sandbox" strips console.* and debugger.
# Unset means prod. Sandbox and prod builds send crash reports to POST /client-errors.
# VITE_DEPLOY_ENV=local

# ── Deploy-only, and NOT a VITE_ variable ───────────────────────────────────
# Scheme + host of the backend, read at REQUEST time by functions/api/[[path]].js, so it never
# reaches the bundle. WEB_ORIGINS and API_PUBLIC_ORIGIN follow from it — see docs/DEPLOY.md.
#   API_ORIGIN=https://draazy-api-sandbox-xxxxx.ondigitalocean.app
# Same value as the backend's ORIGIN_SHARED_SECRET; set as a Pages secret, never in a file.
#   ORIGIN_SHARED_SECRET=

# Override the dev proxy target (defaults to http://localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080

# Google Maps JavaScript API key (PropertyMap / ShareMap display).
# SECURITY — lock this browser key down in Google Cloud Console (it is public in the bundle):
#   1. Application restriction → "HTTP referrers (web sites)". Add your domains only, e.g.
#        https://draazy.com/*   https://www.draazy.com/*   http://localhost:*/*  (dev)
#   2. API restriction → "Restrict key" and enable ONLY: Maps JavaScript API.
#      (Add Places API / Geocoding API only if/when the browser calls them directly.)
#   3. Set a daily quota cap + a billing budget alert to bound abuse cost.
# Left blank on purpose: a previous value leaked, and an example file is the wrong place
# for a real key. Copy this to .env.local and paste your own restricted key there.
VITE_GOOGLE_MAPS_API_KEY=
# Optional Map ID for Advanced Markers. Falls back to Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# ── PMF test overlay (temporary) ────────────────────────────────────────────
# Public product-market-fit build: preview banner, GA4 funnel, Netlify Forms lead capture.
# Every PMF hook is a no-op unless this is exactly "on".
VITE_PMF_MODE=off
# GA4 Measurement ID (public by design). Only used when VITE_PMF_MODE=on.
VITE_GA_ID=

# PostHog product analytics + masked session replay. Loads only after the visitor accepts analytics
# cookies, never on /admin, /ops or /staff. Empty key = off. An EU host also needs the CSP hosts swapped.
# Sandbox/prod builds only: off on the dev server and in a VITE_DEPLOY_ENV=local build, so keep the key out of .env.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# PostHog dashboard URL, linked from Admin > Analytics.
VITE_POSTHOG_APP_URL=

# ── Cashfree hosted checkout ────────────────────────────────────────────────
# Which rails the browser SDK opens: must match the keys the BACKEND holds, or the modal fails to
# open on an unredeemable session id. Sandbox by default so a forgotten value cannot take money.
VITE_CASHFREE_MODE=sandbox

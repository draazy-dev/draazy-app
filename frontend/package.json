{
  "name": "draazy-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-upload-licenses.mjs",
    "models": "node scripts/fetch-models.mjs",
    "prebuild": "npm run models",
    "predev": "npm run models",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "check:i18n": "node scripts/check-i18n-keys.cjs && node scripts/check-i18n-route-namespaces.mjs",
    "check:help": "node scripts/check-help-content.cjs && node scripts/gen-staff-help.mjs --check",
    "gen:staff-help": "node scripts/gen-staff-help.mjs",
    "check:finance": "node scripts/check-finance-period.mjs",
    "check:listing": "node scripts/check-listing-foundation.mjs",
    "check:cycle": "node scripts/check-provider-cycle.mjs",
    "check:routes": "node scripts/check-route-patterns.mjs",
    "check:enums": "node scripts/check-enum-vocabulary.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:colours": "node scripts/check-colours.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check": "npm run lint && npm run check:i18n && npm run check:help && npm run check:finance && npm run check:listing && npm run check:cycle && npm run check:routes && npm run check:enums && npm run check:csp && npm run check:colours",
    "e2e": "npm --prefix ../e2e test",
    "e2e:ui": "npm --prefix ../e2e test -- --ui",
    "e2e:report": "npm --prefix ../e2e run report",
    "preview": "vite preview",
    "rename:brand": "node scripts/rename-brand.mjs"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vis.gl/react-google-maps": "^1.9.0",
    "chart.js": "^4.4.7",
    "heic-to": "1.5.2",
    "i18next": "^24.2.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.1.200",
    "posthog-js": "^1.436.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.7.4",
    "react-router": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "marked": "^15.0.12",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}

# Template: copy to .env.local (git-ignored) and put real keys only there.

CASHFREE_ENABLED=false

# The host and the key prefix must match (TEST_ / PROD_) or every call 401s.
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Backend-only; never expose as VITE_*.
CASHFREE_APP_ID=replace_me
CASHFREE_SECRET_KEY=replace_me

# Cashfree issues no separate webhook secret: set this to CASHFREE_SECRET_KEY.
# Blank makes every forged signature valid.
CASHFREE_WEBHOOK_SECRET=replace_me

# Keep the /api context-path prefix or every callback 404s.
CASHFREE_NOTIFY_URL=

REFERRAL_SIGNAL_SALT=replace_me

# Set-once: rotating it orphans every existing identity hash.
IDENTITY_HASH_SECRET=replace_me

ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_KEY=

# The frontend needs the same public key as VITE_VAPID_PUBLIC_KEY.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:noreply@draazy.com

WHATSAPP_DIGEST_TEMPLATE_NAME=
WHATSAPP_DIGEST_TEMPLATE_LANG=en_US
WHATSAPP_OWNER_NOTICE_TEMPLATE_NAME=
WHATSAPP_OWNER_NOTICE_TEMPLATE_LANG=en_US

# TEMPLATE — safe to commit. Copy to `.env.local` (git-ignored) and put real keys only there.
# `backend/run-local.ps1` loads `.env.local` into the environment before Spring Boot starts.

# Leave false to run on the mock providers; CashfreeClient refuses to boot if a key is blank.
CASHFREE_ENABLED=false

# The host and the key prefix must match (TEST_ / PROD_) or every call 401s.
CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Dashboard → Developers → API Keys. Backend-only; never VITE_*.
CASHFREE_APP_ID=replace_me
CASHFREE_SECRET_KEY=replace_me

# Cashfree issues no separate webhook secret — set this to CASHFREE_SECRET_KEY. Blank makes every
# forged signature valid; wrong-but-set passes every startup check and fails on the first callback.
CASHFREE_WEBHOOK_SECRET=replace_me

# Blank falls back to the dashboard endpoint, which is how deployments run; set a tunnel locally.
# The /api prefix is context-path — without it every callback 404s and still passes the boot check.
CASHFREE_NOTIFY_URL=

# Salts the hashed IP/UA kept against a referral signup for fraud detection (D55). Rotating it only
# costs the fraud desk its comparison window; the hashes are discarded after 90 days anyway.
REFERRAL_SIGNAL_SALT=replace_me

# Keyed-HMAC secret behind identity_hash ("one document, one badge"). Set-once: rotating it orphans
# every existing hash, so a returning holder would read as a new person.
IDENTITY_HASH_SECRET=replace_me

# Zoho ZeptoMail (CPaaS) transactional email. agent_1 > SMTP/API > Send Mail token.
ZEPTOMAIL_ENABLED=false
ZEPTOMAIL_API_KEY=

# Web push. Blank private key = pushes are only logged. Pair: `npx web-push generate-vapid-keys`; the
# frontend needs the same public key as VITE_VAPID_PUBLIC_KEY.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:noreply@draazy.com

# Daily "waiting on you" WhatsApp digest. Blank name = never sent; the template needs Meta approval first.
WHATSAPP_DIGEST_TEMPLATE_NAME=
WHATSAPP_DIGEST_TEMPLATE_LANG=en_US

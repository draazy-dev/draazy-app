config.stopBubbling = true

# A generated toString() on User or IdentityVerification logs the unmasked mobile and Aadhaar.
lombok.toString.flagUsage = ERROR

# Generated equals on a JPA entity triggers lazy loads and breaks Set membership across a persist.
lombok.equalsAndHashCode.flagUsage = ERROR

lombok.data.flagUsage = ERROR

# Required-argument constructors are the entity invariants; a builder makes every field optional.
lombok.builder.flagUsage = ERROR

# DTOs stay records: a settable response lets downstream code reveal a contact the mapper withheld.
lombok.value.flagUsage = ERROR
lombok.allArgsConstructor.flagUsage = ERROR
lombok.requiredArgsConstructor.flagUsage = ERROR

lombok.sneakyThrows.flagUsage = ERROR

lombok.addLombokGeneratedAnnotation = true

lombok.anyConstructor.addConstructorProperties = false

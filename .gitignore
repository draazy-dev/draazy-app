# Logs
logs
*.log
npm-debug.log*

# Dependencies
node_modules
dist
dist-ssr
*.local

# Persisted user data (dev-only, regenerated by the app)
data/persist/
**/data/persist/

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Environment — never commit real keys (Google Maps key lives here).
# Vite exposes VITE_* to the client bundle, so the Maps key must ALSO be
# HTTP-referrer-restricted in Google Cloud Console.
.env
.env.*
!.env.example
# `!.env.live` stood here. That file was a committed *switch* — one line,
# VITE_API_DOMAINS=*, loaded only by `npm run dev:live` — and it had to be tracked
# because a gitignored one would leave a fresh clone running `dev:live` silently on
# mocks. There is no switch and no mock now, so a clone that copies .env.example
# talks to the server or fails visibly. Nothing under .env* is tracked again.

# Cloud credentials. `docs/DEPLOY.md` §5 has the operator run
# `gcloud iam service-accounts keys create key.json` in their working directory, which
# for most people is this one. That file is a PERMANENT credential — it does not expire,
# and it can push an image and read every secret the runtime identity can. **This
# repository is public**, so a stray `git add -A` publishes it to the internet rather
# than merely to history. The runbook says to shred it after pasting it into GitHub;
# this is the net under that instruction, because the window between create and shred is
# exactly when someone commits.
key.json
*-key.json
*.pem
*.p12
*.jks
gha-creds-*.json

.vite
target/
# CLI Maven builds here (backend/.mvn/maven.config) so they never collide with the
# VS Code Java language server, which owns target/.
target-cli/
test-results/
test-results-*/
playwright-report/
playwright/.cache/

# Lighthouse writes its JSON/HTML reports here (.github/lighthouse/run-lighthouse.mjs).
# CI uploads them as an artifact; they are per-run measurements, not source.
.lighthouse/

# Eclipse/IDE compiled output — backend/bin is a full duplicate of backend/src
# plus .class files, produced by the IDE. Never commit it.
backend/bin/
*.class

# Playwright run artifacts (regenerated on every run)
e2e/after-fails.xml
e2e/baseline.json
e2e/*-results.xml
e2e/.shards/

# Editor / scratch artifacts (never commit temp duplicates)
*.jsx.new
*.new
*.orig
*.original.jsx
*.rollback
_rollback/
.rollback/

# Generated patches — share them out-of-band, never commit them
*.patch

# Console captures from a single Maven or Playwright run, redirected to a file so the
# interesting twenty lines can be grepped out of the thousands. They accumulate one per
# attempt — 44 of them reached 10 MB before the first sweep — and every one is a snapshot
# of a run that no longer reflects the tree. `*.log` above does not catch them because the
# habit is `> run.txt`. Scoped to the two directories the commands are run from, so
# `robots.txt` and `frontend/public/third-party/*.txt` stay tracked.
/backend/*.txt
/e2e/*.txt
*.md.bak

# Local, machine-specific DB status snapshot (durable setup docs live in docs/LOCAL_DEV.md).
backend/LOCAL_DB_STATUS.md

# Graphify knowledge graph — generated output, machine-specific paths, multi-MB blobs.
# Regenerated locally; ignored at any depth (repo root and frontend/src both carry one).
graphify-out/

# Scratch specs used to measure something once, never part of the suite
e2e/tests/**/tmp-*.spec.js

# Working notes and one-off analyses kept on disk for the author's own reference.
# Deliberately not committed: they are a running commentary on work in progress, so they
# go stale the moment the work lands and would read as instructions to a future reader.
tasks/scratch/

# VS Code Java-modernization extension scaffolding — tool cruft, not project code
.github/modernize/

# Browser-side ML models for identity verification: 6.5 MB of frozen upstream binary that no
# build step reads and no diff can show. frontend/scripts/fetch-models.mjs downloads them against
# pinned SHA-256 digests, and runs automatically from prebuild and predev.
frontend/public/tessdata/
frontend/public/models/

# Design-review captures. `node e2e/property-shots.mjs` reproduces the whole set against a running
# lane, so the PNGs are a measurement rather than source: 15 MB of them for one pass, and a diff
# that no reviewer can read. This repository is public and history is permanent, so a screenshot
# committed by accident cannot be taken back out by deleting it later.
e2e/shots/
e2e/scratch-shot.mjs
